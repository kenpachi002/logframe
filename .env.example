# ── Database (choose ONE option) ──────────────────────────────────────────────

# Option A: Full URL (Supabase / Railway / Render — paste their connection string)
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=

# Option B: Individual parts (local PostgreSQL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ulpf
# DB_USER=ulpf_user
# DB_PASSWORD=ulpf_pass

# Option C: Leave DATABASE_URL blank AND no DB_HOST/DB_USER → uses SQLite (ulpf.db)
# No configuration needed for SQLite — works out of the box.

# ── Blockchain / ledger ───────────────────────────────────────────────────────
BLOCKCHAIN_LEDGER_PATH=blockchain_ledger/chain.jsonl

# ── Normalizer ────────────────────────────────────────────────────────────────
LOG_TIMEZONE=Asia/Kolkata

# ── Pipeline ──────────────────────────────────────────────────────────────────
BATCH_SIZE=50

# ── Versions ──────────────────────────────────────────────────────────────────
ULPF_VERSION=0.1.0
OCSF_VERSION=1.9.0

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Security & Scalability ───────────────────────────────────────────────────
# Rate limits (syntax: <count>/<minute|second|hour>)
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_INGEST=60/minute

# Maximum payload size in bytes (default: 2097152 = 2MB)
MAX_REQUEST_SIZE_BYTES=2097152

# Optional API key for /api endpoints. If left blank, open demo mode is active.
# ULPF_API_KEY=your-secure-api-key-here
ULPF_API_KEY=
